APP_ENV=local
DATABASE_PATH=data/triage.db
CORPUS_DIR=corpus/synthetic
INDEX_PATH=data/index.json
MODEL_PROVIDER=deterministic
RETRIEVAL_BACKEND=lexical
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_GRAPH_STEPS=8
MAX_TOOL_CALLS=8
RUN_TIMEOUT_SECONDS=20
REDIS_URL=redis://redis:6379/0
QUEUE_BACKEND=memory
MAX_RETRIES=2
# Sentence Transformers uses the PyTorch backend; avoids an unrelated TensorFlow/Keras import.
USE_TF=0


RATE_LIMIT_PER_MINUTE=60
QUEUE_OPERATION_TIMEOUT_SECONDS=2
RETRY_BACKOFF_SECONDS=0.25
RETRY_BACKOFF_MAX_SECONDS=5
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RECOVERY_SECONDS=10
OTEL_SERVICE_NAME=academic-petition-triage
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
