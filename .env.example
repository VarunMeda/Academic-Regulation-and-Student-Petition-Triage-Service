APP_ENV=local
DATABASE_PATH=data/triage.db
CORPUS_DIR=corpus/synthetic
INDEX_PATH=data/index.json
MODEL_PROVIDER=deterministic
MAX_GRAPH_STEPS=8
MAX_TOOL_CALLS=8
RUN_TIMEOUT_SECONDS=20
REDIS_URL=redis://redis:6379/0
# Sentence Transformers uses the PyTorch backend; avoids an unrelated TensorFlow/Keras import.
USE_TF=0

